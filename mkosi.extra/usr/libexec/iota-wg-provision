#!/bin/sh
# Provision this host's per-host WireGuard identity and site tunnel address.
#
#   iota-wg-provision <address>/<prefix> [--rotate] [--stage]
#
# - Tier 1 (Identity): generates a private key (once) and stores it as an
#   encrypted systemd credential in /etc/credstore.encrypted (bind-mounted from
#   /var/lib/credstore.encrypted, bound to TPM2 + host key if TPM2 is present,
#   otherwise to /var/lib/systemd/credential.secret). Never rolled back.
# - Tier 3 (Site data): manages the per-host tunnel address in
#   /var/lib/iota/site/ via iota-site. First-time bootstrap commits and applies
#   immediately; subsequent address changes are staged as a pending generation
#   with a tries counter for trial/commit across reboot.
# - Prints the public key to add as a [WireGuardPeer] in 50-wg0.netdev.
set -eu

CRED_NAME=network.wireguard.private.wg0
CRED_DIR=/etc/credstore.encrypted
CRED="$CRED_DIR/$CRED_NAME"
SITE_CURRENT=/var/lib/iota/site/current

usage() {
    echo "Usage: $0 <address>/<prefix> [--rotate] [--stage]" >&2
    echo "Example: $0 10.100.0.3/24" >&2
    exit 2
}

addr=
rotate=no
stage_only=no

while [ $# -gt 0 ]; do
    case "$1" in
        --rotate) rotate=yes ;;
        --stage) stage_only=yes ;;
        -*) usage ;;
        *) [ -z "$addr" ] || usage; addr=$1 ;;
    esac
    shift
done

[ -n "$addr" ] || usage

case "$addr" in
    */*) ;;
    *) echo "error: address must include a prefix length, e.g. 10.100.0.3/24" >&2; exit 2 ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    echo "error: must be run as root" >&2
    exit 1
fi

umask 077
mkdir -p "$CRED_DIR"
chmod 0700 "$CRED_DIR"

if [ -e "$CRED" ] && [ "$rotate" = no ]; then
    echo "Reusing existing credential $CRED (pass --rotate to replace it)."
    pubkey=$(systemd-creds decrypt --name="$CRED_NAME" "$CRED" - | wg pubkey)
else
    if systemd-creds has-tpm2 --quiet 2>/dev/null; then
        # No PCR binding: UKI updates change PCR 11 and firmware updates can
        # change PCR 7, which would make the key undecryptable after updates.
        set -- --with-key=host+tpm2 --tpm2-pcrs=
    else
        set -- --with-key=host
    fi

    privkey=$(wg genkey)
    tmp="$CRED.tmp.$$"
    trap 'rm -f "$tmp"' EXIT
    printf '%s' "$privkey" | systemd-creds encrypt --name="$CRED_NAME" "$@" - "$tmp"
    mv -f "$tmp" "$CRED"
    trap - EXIT
    pubkey=$(printf '%s\n' "$privkey" | wg pubkey)
    unset privkey
    echo "Wrote encrypted credential $CRED ($*)."
fi

umask 022
if command -v restorecon >/dev/null 2>&1; then
    restorecon -R "$CRED_DIR" 2>/dev/null || true
fi

if [ ! -e "$SITE_CURRENT" ] && [ "$stage_only" = no ]; then
    /usr/libexec/iota-site stage --wg-address "$addr" --tries 3 --force
    /usr/libexec/iota-site commit
    /usr/libexec/iota-site-apply
    # Credentials are imported at service start, so a reload is not enough.
    systemctl restart systemd-networkd.service
else
    cur_addr=
    if [ -f "$SITE_CURRENT/wg0-address.conf" ]; then
        cur_addr=$(awk -F= '/^Address=/{print $2; exit}' "$SITE_CURRENT/wg0-address.conf" || true)
    fi

    if [ "$rotate" = yes ] && [ "$stage_only" = no ] && [ -n "$cur_addr" ] && [ "$cur_addr" = "$addr" ]; then
        echo "Key rotated with unchanged address ($addr); restarting systemd-networkd."
        systemctl restart systemd-networkd.service
    else
        /usr/libexec/iota-site stage --wg-address "$addr" --tries 3
        echo "Staged address $addr as pending site generation; reboot to trial and auto-commit (keeping current as last-known-good)."
    fi
fi

host_ip=${addr%/*}
cat <<EOF

Public key for $(hostname): $pubkey

Add this host to mkosi.extra/usr/lib/systemd/network/50-wg0.netdev:

[WireGuardPeer]
PublicKey=$pubkey
AllowedIPs=$host_ip/32
Endpoint=<public address of this host>:51820
PersistentKeepalive=25
EOF
