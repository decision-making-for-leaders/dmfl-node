[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/decision-making-for-leaders/dmfl-node/releases/latest/download/
MatchPattern=%M_@v_%a.root-%a.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPartitionType=root
MatchPattern=%M_@v
PartitionFlags=0
InstancesMax=2
ReadOnly=yes
