[Unit]
Description=Apply active or pending Iota site configuration
DefaultDependencies=no
After=local-fs.target
Before=systemd-networkd.service systemd-hostnamed.service network-pre.target sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/iota-site-apply

[Install]
WantedBy=sysinit.target
