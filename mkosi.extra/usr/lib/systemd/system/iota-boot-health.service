[Unit]
Description=Verify Iota control path before blessing boot
DefaultDependencies=no
After=network-online.target sshd.socket firewalld.service systemd-networkd.service iota-site-apply.service
Wants=network-online.target
Before=boot-complete.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120s
ExecStart=/usr/libexec/iota-boot-health

[Install]
RequiredBy=boot-complete.target
WantedBy=multi-user.target
