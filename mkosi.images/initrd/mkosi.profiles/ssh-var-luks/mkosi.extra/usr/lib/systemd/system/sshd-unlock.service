[Unit]
Description=Temporary SSH daemon for unlocking /var in initrd
DefaultDependencies=no
After=systemd-networkd.service efi.mount
Wants=systemd-networkd.service
Requires=efi.mount
Conflicts=initrd-switch-root.target
Before=initrd-switch-root.target
ConditionPathIsMountPoint=!/sysroot/var
StartLimitIntervalSec=0

[Service]
RuntimeDirectory=sshd-unlock
RuntimeDirectoryMode=0700
ExecStartPre=/bin/sh -c '[ -f /run/sshd-unlock/ssh_host_ed25519_key ] || /usr/bin/ssh-keygen -t ed25519 -f /run/sshd-unlock/ssh_host_ed25519_key -N "" -q'
ExecStart=/usr/sbin/sshd -D -f /etc/ssh/sshd_unlock_config
Restart=on-failure
RestartSec=2

[Install]
WantedBy=initrd.target
