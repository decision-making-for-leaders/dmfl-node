#!/usr/bin/env python3
"""Move image /var into /usr/share/factory/var and generate tmpfiles.d rules."""

import os
import pathlib
import shutil
import stat
import sys


def escape_tmpfiles(value: str) -> str:
    """Escape a path or argument for tmpfiles.d(5)."""
    out: list[str] = []
    for ch in value:
        if ch == "\\":
            out.append("\\\\")
        elif ch == "%":
            out.append("%%")
        elif ord(ch) < 0x20 or ord(ch) == 0x7F or ch.isspace():
            out.append(f"\\x{ord(ch):02x}")
        else:
            out.append(ch)
    return "".join(out)


def clear_dir_contents(directory: pathlib.Path) -> None:
    """Remove all entries inside directory while keeping directory itself."""
    if not directory.is_dir() or directory.is_symlink():
        return
    for child in directory.iterdir():
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()


def move_tree_contents(src_dir: pathlib.Path, dst_dir: pathlib.Path) -> None:
    """Move all entries from src_dir into dst_dir, merging directories if needed."""
    for src in sorted(src_dir.iterdir(), key=lambda p: p.name):
        dst = dst_dir / src.name
        if not os.path.lexists(dst):
            shutil.move(str(src), str(dst))
        elif (
            src.is_dir()
            and not src.is_symlink()
            and dst.is_dir()
            and not dst.is_symlink()
        ):
            move_tree_contents(src, dst)
            src.rmdir()
        else:
            if dst.is_dir() and not dst.is_symlink():
                shutil.rmtree(dst)
            else:
                dst.unlink()
            shutil.move(str(src), str(dst))


def collect_tmpfiles_lines(factory_var: pathlib.Path) -> list[str]:
    """Walk factory_var in sorted top-down order and build tmpfiles.d entries."""
    lines: list[str] = []

    def walk(current_dir: pathlib.Path) -> None:
        for entry in sorted(current_dir.iterdir(), key=lambda p: p.name):
            st = os.lstat(entry)
            rel = entry.relative_to(factory_var).as_posix()
            escaped_rel = escape_tmpfiles(rel)

            if stat.S_ISDIR(st.st_mode):
                mode = f"{stat.S_IMODE(st.st_mode):04o}"
                lines.append(
                    f"d /var/{escaped_rel} {mode} {st.st_uid} {st.st_gid} -"
                )
                walk(entry)
            elif stat.S_ISLNK(st.st_mode):
                target = escape_tmpfiles(os.readlink(entry))
                lines.append(f"L /var/{escaped_rel} - - - - {target}")
            elif stat.S_ISREG(st.st_mode):
                lines.append(
                    f"C /var/{escaped_rel} - - - - /usr/share/factory/var/{escaped_rel}"
                )

    walk(factory_var)
    return lines


def main() -> int:
    buildroot_env = os.environ.get("BUILDROOT")
    if not buildroot_env:
        print("BUILDROOT environment variable is not set", file=sys.stderr)
        return 1

    buildroot = pathlib.Path(buildroot_env)
    var_dir = buildroot / "var"
    if not var_dir.exists() or var_dir.is_symlink() or not var_dir.is_dir():
        return 0

    clear_dir_contents(var_dir / "cache")
    clear_dir_contents(var_dir / "tmp")

    factory_var = buildroot / "usr/share/factory/var"
    factory_var.mkdir(parents=True, exist_ok=True)
    move_tree_contents(var_dir, factory_var)

    lines = [
        "# Auto-generated by mkosi.finalize from /usr/share/factory/var.",
        *collect_tmpfiles_lines(factory_var),
    ]

    tmpfiles_dir = buildroot / "usr/lib/tmpfiles.d"
    tmpfiles_dir.mkdir(parents=True, exist_ok=True)
    tmpfiles_conf = tmpfiles_dir / "zz-var-factory.conf"
    tmpfiles_conf.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.chmod(tmpfiles_conf, 0o644)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
